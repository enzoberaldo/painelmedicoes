<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

  :root{
    --bg: #EEF0F3;
    --paper: #FFFFFF;
    --ink: #2B3138;
    --ink-soft: #8B92A0;
    --line: #ECEDF1;

    --orange: #F2994A;
    --orange-soft: #FDEEE0;
    --green: #27AE60;
    --green-soft: #E6F7ED;
    --deepgreen: #1E5631;
    --deepgreen-soft: #E1EAE3;
    --blue: #2F80ED;
    --blue-soft: #E8F0FE;
    --red: #E0564A;
    --red-soft: #FBE7E5;
    --shadow: 0 4px 20px rgba(43,49,56,.06);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--bg);
    min-height:100vh;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:22px 22px 80px;}

  .shell{
    background:var(--paper);border-radius:24px;box-shadow:var(--shadow);
    padding:18px 22px 26px;
  }

  header.top{
    display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:14px;margin-bottom:18px;
  }
  .wordmark{font-family:'Manrope',sans-serif;font-weight:800;font-size:20px;letter-spacing:-0.02em;color:var(--ink);}
  .wordmark span{color:var(--orange);}
  .updated-box{
    font-size:11.5px;color:var(--ink-soft);text-align:right;line-height:1.5;
  }
  .updated-box b{color:var(--ink);font-weight:600;}

  .tabs{display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap;}
  .tab-btn{
    display:flex;align-items:center;gap:9px;
    font-family:'Manrope',sans-serif;font-size:13.5px;font-weight:700;
    padding:9px 18px 9px 9px;border:none;background:var(--bg);
    cursor:pointer;color:var(--ink-soft);border-radius:30px;
    transition:.15s;
  }
  .tab-btn .ic{
    width:26px;height:26px;border-radius:50%;background:#fff;color:var(--ink-soft);
    display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;
    box-shadow:0 1px 3px rgba(0,0,0,.08);
  }
  .tab-btn.active{background:var(--orange);color:#fff;}
  .tab-btn.active .ic{background:#fff;color:var(--orange);}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  .section-head{display:flex;align-items:center;gap:12px;background:var(--orange);color:#fff;
    border-radius:14px;padding:11px 18px;margin:26px 0 16px;}
  .section-head .badge{
    width:26px;height:26px;border-radius:50%;background:#fff;color:var(--orange);
    display:flex;align-items:center;justify-content:center;font-family:'Manrope',sans-serif;
    font-weight:800;font-size:13px;flex:none;
  }
  .section-head h3{font-family:'Manrope',sans-serif;font-size:14px;letter-spacing:.03em;
    text-transform:uppercase;margin:0;font-weight:700;}

  .upload-bar{
    display:flex;align-items:center;gap:14px;background:var(--bg);
    border-radius:14px;padding:13px 18px;margin-bottom:6px;
    flex-wrap:wrap;
  }
  .drop{
    border:1.5px dashed var(--orange);border-radius:10px;padding:9px 16px;
    font-size:12.5px;font-weight:600;color:var(--orange);
    cursor:pointer;background:var(--orange-soft);transition:.15s;
  }
  .drop:hover{background:#fbdfc0;}
  .drop.drag{background:#f8cfa0;}
  input[type=file]{display:none;}
  .meta{font-size:12px;color:var(--ink-soft);}

  .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:18px 0 8px;}
  .kpi{
    background:var(--paper);border:1px solid var(--line);border-radius:16px;
    padding:16px 18px;cursor:default;box-shadow:var(--shadow);
  }
  .kpi .tag{
    display:inline-block;font-size:10.5px;font-weight:700;padding:3px 10px;border-radius:20px;
    margin-bottom:10px;letter-spacing:.02em;
  }
  .kpi.c-green .tag{background:var(--green-soft);color:var(--green);}
  .kpi.c-orange .tag{background:var(--orange-soft);color:var(--orange);}
  .kpi.c-blue .tag{background:var(--blue-soft);color:var(--blue);}
  .kpi.c-red .tag{background:var(--red-soft);color:var(--red);}
  .kpi .num{font-family:'Manrope',sans-serif;font-size:27px;font-weight:800;line-height:1;margin-bottom:10px;}
  .kpi .lbl{font-size:11.5px;color:var(--ink-soft);margin-bottom:10px;min-height:28px;}
  .kpi-bar{height:6px;border-radius:6px;background:var(--bg);overflow:hidden;margin-bottom:6px;}
  .kpi-fill{height:100%;border-radius:6px;width:0%;transition:width .4s;}
  .kpi.c-green .kpi-fill{background:var(--green);}
  .kpi.c-orange .kpi-fill{background:var(--orange);}
  .kpi.c-blue .kpi-fill{background:var(--blue);}
  .kpi.c-red .kpi-fill{background:var(--red);}
  .kpi-pct{font-size:11px;color:var(--ink-soft);font-weight:600;}

  .seg{display:inline-flex;background:var(--bg);border-radius:30px;padding:3px;margin-bottom:6px;}
  .seg button{
    font-size:12px;font-weight:700;padding:7px 16px;border:none;border-radius:30px;
    background:transparent;cursor:pointer;color:var(--ink-soft);
  }
  .seg button.active{background:var(--paper);color:var(--ink);box-shadow:var(--shadow);}

  .grid-2{display:grid;grid-template-columns:1.1fr 1fr;gap:18px;margin-bottom:8px;}
  .card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--shadow);}
  .card h3.ch{
    font-family:'Manrope',sans-serif;font-size:13px;margin:0 0 14px;
    text-transform:uppercase;letter-spacing:.04em;color:var(--ink-soft);font-weight:700;
  }
  .card-foot{font-size:11.5px;color:var(--ink-soft);margin-top:8px;}

  .progress-wrap{height:30px;background:var(--bg);border-radius:30px;overflow:hidden;position:relative;}
  .progress-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--orange));display:flex;align-items:center;justify-content:flex-end;padding-right:12px;border-radius:30px;}
  .progress-fill span{font-family:'Manrope',sans-serif;color:#fff;font-weight:800;font-size:12.5px;}

  table{width:100%;border-collapse:collapse;font-size:13px;}
  th{
    text-align:left;font-size:10.5px;font-weight:700;
    text-transform:uppercase;color:var(--ink-soft);border-bottom:1.5px solid var(--line);
    padding:9px 8px;letter-spacing:.03em;
  }
  td{padding:9px 8px;border-bottom:1px solid var(--line);}
  tbody tr:hover td{background:var(--bg);}
  tbody tr:nth-child(even) td{background:#FAFBFC;}
  tbody tr:nth-child(even):hover td{background:var(--bg);}

  select, .fselect{
    font-family:'Inter',sans-serif;padding:9px 14px;border:1.5px solid var(--line);
    border-radius:30px;background:var(--paper);font-size:13px;min-width:260px;color:var(--ink);
  }

  .ruler{display:flex;gap:5px;margin-top:8px;}
  .ruler .seg-block{flex:1;height:24px;border-radius:6px;background:var(--bg);position:relative;}
  .ruler .seg-block.lit{background:var(--green);}
  .ruler .seg-block.lit.last{background:var(--orange);}
  .ruler-labels{display:flex;gap:5px;margin-top:6px;}
  .ruler-labels span{flex:1;font-size:9.5px;text-align:center;color:var(--ink-soft);line-height:1.2;font-weight:600;}

  .empty{padding:40px 10px;text-align:center;color:var(--ink-soft);font-size:13px;}
  .empty b{display:block;font-family:'Manrope',sans-serif;font-size:16px;color:var(--ink);margin-bottom:6px;}

  .pill{display:inline-block;padding:3px 10px;border-radius:20px;font-size:10.5px;font-weight:700;}
  .pill.novo{background:var(--orange-soft);color:var(--orange);}
  .pill.aditivo{background:var(--blue-soft);color:var(--blue);}

  .row-green td{background:var(--green-soft) !important;}
  .row-red td{background:var(--red-soft) !important;}

  .btn{
    font-size:11.5px;font-weight:700;padding:7px 14px;border-radius:30px;
    border:1.5px solid var(--ink);background:var(--paper);cursor:pointer;color:var(--ink);
  }
  .btn:hover{background:var(--ink);color:#fff;}
  .legend{display:flex;gap:18px;font-size:11.5px;color:var(--ink-soft);margin:0 0 16px;font-weight:600;}
  .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px;}
  .note{font-size:11.5px;color:var(--blue);background:var(--blue-soft);border-radius:10px;padding:10px 14px;margin-bottom:16px;font-weight:600;}

  @media(max-width:880px){
    .kpi-grid{grid-template-columns:repeat(2,1fr);}
    .grid-2{grid-template-columns:1fr;}
  }
</style>
</head>
