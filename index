    }
  });

  // LINHA: valor retido por data de caução
  const linhaRows = caucoesRows
    .filter(r=>r.temCaucao && r.valorRetido>0)
    .map(r=>({
      dt: r.dtRealizada || r.dtProgramada,
      valorRetido:    r.valorRetido,
      valorDevolvido: r.valorDevolvido,
      saldo:          r.saldoCaucao,
      cod:            r.cod,
    }))
    .filter(r=>r.dt)
    .sort((a,b)=>a.dt-b.dt);

  const ctxLinha = document.getElementById('chart-caucoes-linha').getContext('2d');
  if(caucoesLinhaChart) caucoesLinhaChart.destroy();
  caucoesLinhaChart = new Chart(ctxLinha,{
    type:'line',
    data:{
      labels: linhaRows.map(r=>r.dt.toLocaleDateString('pt-BR')),
      datasets:[{
        label:'Valor Retido',
        data: linhaRows.map(r=>r.valorRetido),
        borderColor:'#2F80ED',
        backgroundColor:'rgba(47,128,237,0.08)',
        pointBackgroundColor:'#2F80ED',
        tension:.3,fill:true,
      }]
    },
    options:{
      plugins:{
        legend:{display:false},
        tooltip:{
          callbacks:{
            label: (ctx)=>{
              const d = linhaRows[ctx.dataIndex];
              return [
                `Retido: ${fmtBRL(d.valorRetido)}`,
                `Devolvido: ${fmtBRL(d.valorDevolvido)}`,
                `Saldo: ${fmtBRL(d.saldo)}`,
              ];
            }
          }
        }
      },
      scales:{
        x:{ticks:{font:{size:9},maxRotation:45}},
        y:{ticks:{callback:v=>fmtBRL(v)}}
      }
    }
  });

  // TABELA CAUÇÕES
  renderTabelaCaucoes();

  // TABELA ENCERRAMENTO
  renderTabelaEncerramento();
}

function renderTabelaCaucoes(){
  const now = new Date();
  const busca = norm(document.getElementById('busca-caucoes').value||'');
  const tbody = document.querySelector('#tabela-caucoes tbody');
  tbody.innerHTML='';

  let rows = caucoesRows.filter(r=>r.temCaucao);

  // filtro status
  if(caucoesFiltro==='pagas')    rows = rows.filter(r=>r.dtRealizada);
  if(caucoesFiltro==='apagar')   rows = rows.filter(r=>!r.dtRealizada && r.dtProgramada && r.dtProgramada>=now);
  if(caucoesFiltro==='atrasadas')rows = rows.filter(r=>!r.dtRealizada && r.dtProgramada && r.dtProgramada<now);

  // busca
  if(busca) rows = rows.filter(r=>norm(r.cod).includes(busca)||norm(r.contratado).includes(busca));

  // ordenação: mais antiga primeiro; pagas usam dtRealizada
  rows.sort((a,b)=>{
    const da = a.dtRealizada||a.dtProgramada||new Date(9999,0);
    const db = b.dtRealizada||b.dtProgramada||new Date(9999,0);
    return da-db;
  });

  rows.forEach(r=>{
    const isPaga     = !!r.dtRealizada;
    const isAtrasada = !r.dtRealizada && r.dtProgramada && r.dtProgramada < now;
    const tr = document.createElement('tr');
    if(isPaga)     tr.className='row-green';
    else if(isAtrasada) tr.className='row-red';
    const dtMostra = isPaga ? fmtDateBR(r.dtRealizada) : fmtDateBR(r.dtProgramada);
    tr.innerHTML=`<td>${dtMostra}</td><td>${r.contratado}</td><td>${r.cod}</td><td>${fmtBRL(r.valorRetido)}</td><td>${fmtBRL(r.valorDevolvido)}</td><td>${fmtBRL(r.saldoCaucao)}</td>`;
    tbody.appendChild(tr);
  });
  if(!rows.length){
    tbody.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--ink-soft);padding:20px;">Nenhuma caução nesse filtro.</td></tr>';
  }
}

function renderTabelaEncerramento(){
  const now = new Date();
  const tbody = document.querySelector('#tabela-encerramento tbody');
  tbody.innerHTML='';

  let rows = caucoesRows.filter(r=>r.termino);

  // aplica filtro
  rows = rows.filter(r=>{
    const encerrado = r.situacao==='ENCERRADO' || !!r.dtEncerramento;
    const vencido   = !encerrado && r.termino < now;
    if(encerramentoFiltro==='encerrado') return encerrado;
    if(encerramentoFiltro==='vencido')   return vencido;
    if(encerramentoFiltro==='andamento') return !encerrado && !vencido;
    return true;
  });

  rows.sort((a,b)=>a.termino-b.termino);

  rows.forEach(r=>{
    const encerrado = r.situacao==='ENCERRADO' || !!r.dtEncerramento;
    const vencido   = !encerrado && r.termino < now;
    const tr = document.createElement('tr');
    if(encerrado)    tr.className='row-green';
    else if(vencido) tr.className='row-red';
    tr.innerHTML=`<td>${fmtDateBR(r.termino)}</td><td>${r.cod}</td><td>${r.contratado}</td><td>${r.situacao}</td><td>${fmtDateBR(r.dtEncerramento)}</td>`;
    tbody.appendChild(tr);
  });
  if(!rows.length){
    tbody.innerHTML='<tr><td colspan="5" style="text-align:center;color:var(--ink-soft);padding:20px;">Nenhum contrato nesse filtro.</td></tr>';
  }
}

/* ---------- storage cauções ---------- */
function saveCaucoes(){
  try{
    const payload={rows:caucoesRows.map(r=>({
      ...r,
      termino:        r.termino?        r.termino.toISOString()        : null,
      dtEncerramento: r.dtEncerramento? r.dtEncerramento.toISOString() : null,
      dtRealizada:    r.dtRealizada?    r.dtRealizada.toISOString()    : null,
      dtProgramada:   r.dtProgramada?   r.dtProgramada.toISOString()   : null,
    })), updatedAt:new Date().toISOString()};
    localStorage.setItem('integra-caucoes-data', JSON.stringify(payload));
  }catch(e){console.error(e);}
}
function loadCaucoes(){
  try{
    const raw = localStorage.getItem('integra-caucoes-data');
    if(raw){
      const payload = JSON.parse(raw);
      caucoesRows = (payload.rows||[]).map(r=>({
        ...r,
        termino:        r.termino?        new Date(r.termino)        : null,
        dtEncerramento: r.dtEncerramento? new Date(r.dtEncerramento) : null,
        dtRealizada:    r.dtRealizada?    new Date(r.dtRealizada)    : null,
        dtProgramada:   r.dtProgramada?   new Date(r.dtProgramada)   : null,
      }));
      document.getElementById('upd-contratos').textContent = new Date(payload.updatedAt).toLocaleString('pt-BR');
      document.getElementById('meta-caucoes').textContent = `${caucoesRows.length} contratos carregados.`;
      renderCaucoes();
    }
  }catch(e){}
}

/* ---------- file handler cauções ---------- */
document.getElementById('drop-caucoes').addEventListener('click',()=>document.getElementById('file-caucoes').click());
document.getElementById('file-caucoes').addEventListener('change', async(e)=>{
  const file = e.target.files[0];
  if(!file) return;
  try{
    const wb = await readWorkbook(file);
    caucoesRows = parseCaucoes(wb);
    document.getElementById('upd-contratos').textContent = nowStamp();
    document.getElementById('meta-caucoes').textContent = `${caucoesRows.length} contratos carregados de "${file.name}".`;
    renderCaucoes();
    saveCaucoes();
  }catch(err){ alert('Erro ao ler planilha: '+err.message); }
});

// drag-and-drop cauções
document.getElementById('drop-caucoes').addEventListener('dragover',e=>{e.preventDefault();document.getElementById('drop-caucoes').classList.add('drag');});
document.getElementById('drop-caucoes').addEventListener('dragleave',()=>document.getElementById('drop-caucoes').classList.remove('drag'));
document.getElementById('drop-caucoes').addEventListener('drop',e=>{
  e.preventDefault();document.getElementById('drop-caucoes').classList.remove('drag');
  document.getElementById('file-caucoes').files=e.dataTransfer.files;
  document.getElementById('file-caucoes').dispatchEvent(new Event('change'));
});

// filtros cauções
document.querySelectorAll('#seg-caucoes button').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#seg-caucoes button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    caucoesFiltro = btn.dataset.c;
    renderTabelaCaucoes();
  });
});
document.getElementById('busca-caucoes').addEventListener('input',()=>renderTabelaCaucoes());

document.querySelectorAll('#seg-encerramento button').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#seg-encerramento button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    encerramentoFiltro = btn.dataset.e;
    renderTabelaEncerramento();
  });
});

/* ---------- init ---------- */
loadMedicoes();
loadContratos();
loadCaucoes();

</script>


