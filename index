}

/* ---------- contratos ---------- */
let contratosEntries = []; // {id, type, code, n, label, fornecedor, firstSeen(ISO), status, doneDate(ISO)}
let contratosStatusFilter = 'todos';

function parseContratosWorkbook(workbook, out){
  workbook.SheetNames.forEach(sn=>{
    const ws = workbook.Sheets[sn];
    const rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});

    // encontra header: linha que tem "cod" e "contrato"
    let hIdx = -1;
    for(let i=0;i<rows.length;i++){
      const cells = (rows[i]||[]).map(c=>norm(String(c||'')));
      if(cells.some(c=>c.includes('cod') && c.includes('contrato'))){ hIdx=i; break; }
    }
    if(hIdx===-1) return;

    const header = rows[hIdx];

    // Usa COD. CONTRATO (código completo tipo OS_INT2_0075_2026)
    // Evita COD. CONTRATO UAU e COD. FORN UAU que têm valores inconsistentes
    let cCode = -1;
    for(let i=0;i<header.length;i++){
      const c = norm(String(header[i]||''));
      if(c.includes('cod') && c.includes('contrato') && !c.includes('uau') && !c.includes('forn')){
        cCode=i; break;
      }
    }
    if(cCode===-1) return;

    const cFantasia   = colIndex(header,['nome','fantasia']);
    const cContratado = colIndex(header,['contratado']);

    // match exato para aditivos — evita 'ADITIVO 5' bater em 'ADITIVO 15'
    const aditivoIdx = [];
    for(let n=1;n<=13;n++){
      for(let i=0;i<header.length;i++){
        const c = norm(String(header[i]||''));
        // match exato: deve ser exatamente "aditivo N" (sem outros números após)
        if(c === 'aditivo '+n || c === 'aditivo 0'+n){
          aditivoIdx.push({n, idx:i}); break;
        }
      }
    }

    for(let i=hIdx+1;i<rows.length;i++){
      const r = rows[i];
      if(!r) continue;
      const rawCode = r[cCode];
      if(!isFilled(rawCode)) continue;
      const code = String(rawCode).trim();
      // código válido: deve ter letra E underscore (ex: OS_INT2_0075_2026) — descarta número puro, PENDENTE sem _, lixo
      if(!/[A-Za-z]/.test(code) || !code.includes('_')) continue;
      if(out.seenCodes.has(code)) continue;
      out.seenCodes.add(code);
      const fornecedor = (cFantasia>-1 && isFilled(r[cFantasia]))
        ? r[cFantasia]
        : (cContratado>-1 && isFilled(r[cContratado]) ? r[cContratado] : '');
      out.contracts.push({code, fornecedor, aditivos: aditivoIdx.map(a=>({n:a.n, value:r[a.idx]}))});
    }
  });
}

function reconcileContratos(parsedContracts){
  const nowISO = new Date().toISOString();
  const existingIds = new Set(contratosEntries.map(e=>e.id));

  parsedContracts.forEach(c=>{
    const novoId = 'novo__'+c.code;
    if(!existingIds.has(novoId)){
      contratosEntries.push({id:novoId, type:'novo', code:c.code, n:null, label:`${c.code} — ${c.fornecedor}`, fornecedor:c.fornecedor, firstSeen:nowISO, status:'pendente', doneDate:null});
      existingIds.add(novoId);
    }
    c.aditivos.forEach(a=>{
      if(isFilled(a.value)){
        const adId = `tac${a.n}__${c.code}`;
        if(!existingIds.has(adId)){
          contratosEntries.push({id:adId, type:'aditivo', code:c.code, n:a.n, label:`TAC ${String(a.n).padStart(2,'0')} - ${c.code} - ${c.fornecedor}`, fornecedor:c.fornecedor, firstSeen:nowISO, status:'pendente', doneDate:null});
          existingIds.add(adId);
        }
      }
    });
  });
}

function renderContratos(filterText=''){
  const tbody = document.querySelector('#tabela-contratos tbody');
  tbody.innerHTML='';
  document.getElementById('contratos-empty').style.display = contratosEntries.length? 'none':'block';
  const now = new Date();

  // archive done items older than 7 days from view (kept in storage, just hidden)
  let visible = contratosEntries.filter(e=> !(e.status==='feito' && e.doneDate && daysBetween(new Date(e.doneDate), now) > 7));

  // apply status filter
  if(contratosStatusFilter === 'pendente'){
    visible = visible.filter(e=> e.status !== 'feito');
  } else if(contratosStatusFilter === 'feito'){
    visible = visible.filter(e=> e.status === 'feito');
  }

  // apply search filter
  if(filterText.trim()){
    const q = norm(filterText);
    visible = visible.filter(e=>
      norm(e.label).includes(q) ||
      norm(e.code).includes(q) ||
      norm(e.fornecedor).includes(q)
    );
  }

  visible.sort((a,b)=> new Date(b.firstSeen)-new Date(a.firstSeen));

  visible.forEach(e=>{
    const tr = document.createElement('tr');
    let rowClass='';
    if(e.status==='feito') rowClass='row-green';
    else if(daysBetween(new Date(e.firstSeen), now) > 7) rowClass='row-red';
    tr.className = rowClass;
    const detectado = new Date(e.firstSeen).toLocaleDateString('pt-BR');
    const isFeito = e.status==='feito';
    const btn = `<button class="btn" data-id="${e.id}" data-toggle="true">${isFeito? '✕ Desmarcar' : '✓ Marcar cadastrado'}</button>`;
    tr.innerHTML = `<td>${e.label}</td><td><span class="pill ${e.type}">${e.type==='novo'?'Novo contrato':'Aditivo'}</span></td><td>${e.code}</td><td>${e.fornecedor||''}</td><td>${detectado}</td><td>${btn}</td>`;
    tbody.appendChild(tr);
  });

  tbody.querySelectorAll('button[data-toggle]').forEach(b=>{
    b.addEventListener('click', async ()=>{
      const id = b.getAttribute('data-id');
      const entry = contratosEntries.find(e=>e.id===id);
      if(entry.status==='feito'){
        // desmarcar
        entry.status='pendente';
        entry.doneDate=null;
      } else {
        // marcar
        entry.status='feito';
        entry.doneDate = new Date().toISOString();
      }
      saveContratos();
      renderContratos(filterText);
    });
  });
}

