<script>

/* ---------- helpers ---------- */
function norm(s){
  return (s===null||s===undefined?'':String(s))
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/\s+/g,' ').trim().toLowerCase();
}
function isFilled(v){
  if(v===null||v===undefined) return false;
  if(v instanceof Date) return !isNaN(v);
  if(typeof v==='number') return true;
  const t=String(v).trim().toUpperCase();
  if(t===''||t==='#VALUE!') return false;
  return true;
}
function fmtDate(v){
  if(v instanceof Date && !isNaN(v)) return v.toLocaleDateString('pt-BR');
  return v===null||v===undefined?'':String(v);
}
function monthKey(v){
  if(v instanceof Date && !isNaN(v)) return v.getFullYear()+'-'+String(v.getMonth()+1).padStart(2,'0');
  return null;
}
function monthLabel(key){
  if(!key) return '—';
  const [y,m]=key.split('-');
  const meses=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return meses[parseInt(m,10)-1]+'/'+y.slice(2);
}
function findHeaderRow(rows, mustHave){
  for(let i=0;i<rows.length;i++){
    const cells=(rows[i]||[]).map(norm);
    if(mustHave.every(req=>cells.some(c=>req.every(k=>c.includes(k))))) return i;
  }
  return -1;
}
function colIndex(headerRow, keywords){
  for(let i=0;i<headerRow.length;i++){
    const c=norm(headerRow[i]);
    if(keywords.every(k=>c.includes(k))) return i;
  }
  return -1;
}
function nowStamp(){
  return new Date().toLocaleString('pt-BR');
}
function daysBetween(a,b){
  return Math.floor((b-a)/(1000*60*60*24));
}

function setKpi(id, value, pct){
  const card = document.getElementById(id);
  card.querySelector('.num').textContent = value;
  const fill = card.querySelector('.kpi-fill');
  if(fill){ fill.style.width = Math.min(pct,100)+'%'; }
  const pctLabel = card.querySelector('.kpi-pct');
  if(pctLabel){ pctLabel.textContent = pct+'%'; }
}

/* ---------- state ---------- */
let medicoesRows = [];
let medicoesCols = {};
let currentSegment = 'todos';
let respFilter = 'todos';
let pizzaFilterPhase = null;
let pizzaChart=null, barChart=null;

const PHASES = [
  {key:'envio_obra', label:'Envio à Obra', match:['envio','espelho','obra']},
  {key:'aprov_obra', label:'Aprovação da Obra', match:['aprovacao','espelho','obra']},
  {key:'lanc_uau', label:'Lançamento UAU', match:['lancamento','uau','realizado']},
  {key:'aprov_uau', label:'Aprovação UAU', match:['aprovacao','uau','realizado']},
  {key:'lib_bm', label:'Liberação BM', match:['liberacao','realizado']},
  {key:'receb_nf', label:'Recebimento NF', match:['recebimento','nf','realizado']},
  {key:'envio_fin', label:'Envio ao Financeiro', match:['envio','financ','realizado']},
];

/* ---------- XLSX parsing: medições ---------- */
function parseMedicoes(workbook){
  const sheetName = workbook.SheetNames.find(n=>norm(n).includes('cronograma')) || workbook.SheetNames[0];
  const ws = workbook.Sheets[sheetName];
  const rows    = XLSX.utils.sheet_to_json(ws, {header:1, raw:false, cellDates:true, defval:null});
  const rowsRaw = XLSX.utils.sheet_to_json(ws, {header:1, raw:true,  cellDates:true, defval:null});

  // encontra header: linha que tem "fornecedor" E alguma coluna com "espelho"
  let hIdx = -1;
  for(let i=0;i<rows.length;i++){
    const cells = (rows[i]||[]).map(c=>norm(String(c||'')));
    if(cells.some(c=>c==='fornecedor') && cells.some(c=>c.includes('espelho'))){ hIdx=i; break; }
  }
  if(hIdx===-1) throw new Error('Não encontrei a linha de cabeçalho na aba de cronograma. Verifique se o arquivo é o esperado.');
  const header = rows[hIdx];

  function col(keywords){
    for(let i=0;i<header.length;i++){
      const c=norm(String(header[i]||''));
      if(keywords.every(k=>c.includes(k))) return i;
    }
    return -1;
  }

  const c = {
    fornecedor:       col(['fornecedor']),
    mes:              col(['mes']),
    setor:            col(['setor']),
    contrato:         col(['cod','contrato']),
    statusMed:        col(['status','medic']),
    resp:             col(['resp']),
    espelhoRealizado: col(['espelho','realizado']),
    envioObra:        col(['envio','espelho','obra']),
    aprovObra:        col(['aprovacao','espelho','obra']),
    lancUauReal:      col(['lancamento','uau','realizado']),
    aprovUauReal:     col(['aprovacao','uau','realizado']),
    libBmReal:        col(['liberacao','bm','realizado']),
    recebNfReal:      col(['recebimento','nf','realizado']),
    envioFinReal:     col(['envio','financ','realizado']),
  };
  medicoesCols = c;

  const data = [];
  for(let i=hIdx+1;i<rows.length;i++){
    const r    = rows[i];
    const rRaw = rowsRaw[i];
    if(!r || c.fornecedor===-1 || !isFilled(r[c.fornecedor])) continue;

    // monthKey robusto: tenta Date object, número serial Excel, ou string
    let mk = null;
    if(rRaw && c.mes>-1){
      const rawMes = rRaw[c.mes];
      if(rawMes instanceof Date && !isNaN(rawMes)){
        mk = rawMes.getFullYear()+'-'+String(rawMes.getMonth()+1).padStart(2,'0');
      } else if(typeof rawMes==='number' && rawMes>0){
        const d = new Date(Math.round((rawMes-25569)*86400*1000));
        if(!isNaN(d)) mk = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
      } else if(rawMes){
        const d = new Date(rawMes);
        if(!isNaN(d)) mk = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
      }
    }

    data.push({
      fornecedor:       r[c.fornecedor],
      mes:              c.mes>-1?       r[c.mes]       : null,
      mesKey:           mk,
      setor:            c.setor>-1?     r[c.setor]     : '',
      contrato:         c.contrato>-1?  r[c.contrato]  : '',
      statusMed:        c.statusMed>-1? r[c.statusMed] : '',
      resp:             c.resp>-1?      String(r[c.resp]||'').trim() : '',
      espelhoRealizado: isFilled(r[c.espelhoRealizado]),
      envioObra:        isFilled(r[c.envioObra]),
      aprovObra:        isFilled(r[c.aprovObra]),
      lancUauReal:      isFilled(r[c.lancUauReal]),
      aprovUauReal:     isFilled(r[c.aprovUauReal]),
      libBmReal:        isFilled(r[c.libBmReal]),
      recebNfReal:      isFilled(r[c.recebNfReal]),
      envioFinReal:     isFilled(r[c.envioFinReal]),
    });
  }
  return data;
}

// Retorna as fases "efetivas" de uma medição:
// - Se uma fase posterior está preenchida, considera as anteriores como concluídas
// - Aprovação UAU (índice 3): acende se explicitamente preenchida OU se envioFinReal estiver preenchido
function effectivePhases(row){
  const raw = [row.envioObra, row.aprovObra, row.lancUauReal, row.aprovUauReal, row.libBmReal, row.recebNfReal, row.envioFinReal];
  const APROV_UAU_IDX = 3;

  // aprovUAU é considerada concluída se: preenchida na planilha OU envioFin preenchido
  const aprovUauEff = row.aprovUauReal || row.envioFinReal || false;

  // array com aprovUAU já resolvida
  const resolved = raw.map((v,i)=> i===APROV_UAU_IDX ? aprovUauEff : v);

  // descobre o índice mais avançado preenchido
  let lastFilled = -1;
  for(let i=0;i<resolved.length;i++){ if(resolved[i]) lastFilled=i; }

  // preenche automaticamente tudo antes de lastFilled
  return resolved.map((v,i)=> i<lastFilled ? true : v);
}

function currentPhaseOf(row){
  const eff = effectivePhases(row);
  for(let i=0;i<eff.length;i++){ if(!eff[i]) return PHASES[i]; }
  return null; // tudo concluído
}

/* ---------- render: medições ---------- */
function thisMonthKey(){
  const d=new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
}

function applyResp(rows){
  if(respFilter === 'todos') return rows;
  return rows.filter(r=>norm(r.resp).includes(norm(respFilter)));
}

function applySegment(rows){
  const cur = thisMonthKey();
  let result = rows;
  if(currentSegment==='atrasados') result = result.filter(r=>r.espelhoRealizado && !r.envioFinReal && r.mesKey && r.mesKey<cur);
  else if(currentSegment==='mesatual') result = result.filter(r=>r.mesKey===cur);
  return result;
}

function renderMedicoes(){
  const cur = thisMonthKey();
  document.getElementById('medicoes-empty').style.display = medicoesRows.length? 'none':'block';
  document.getElementById('medicoes-content').style.display = medicoesRows.length? 'block':'none';
  if(!medicoesRows.length) return;

  // aplica filtro de resp como base de tudo
  const filtered = applyResp(medicoesRows);

  const recebidasMes = filtered.filter(r=>r.espelhoRealizado && r.mesKey===cur).length;
  const andamento = filtered.filter(r=>r.espelhoRealizado && !r.envioFinReal);
  const andamentoMes = andamento.filter(r=>r.mesKey===cur);
  const atrasadas = andamento.filter(r=>r.mesKey && r.mesKey<cur);

  const doMesTotal = filtered.filter(r=>r.mesKey===cur).length;
  setKpi('kpi-recebidas', recebidasMes, doMesTotal? Math.round(100*recebidasMes/doMesTotal):0);
  setKpi('kpi-andamento', andamento.length, filtered.length? Math.round(100*andamento.length/filtered.length):0);
  setKpi('kpi-andamento-mes', andamentoMes.length, andamento.length? Math.round(100*andamentoMes.length/andamento.length):0);
  setKpi('kpi-atrasadas', atrasadas.length, andamento.length? Math.round(100*atrasadas.length/andamento.length):0);

  // % conclusão: aplica resp
  const emAndamentoGeral = filtered.filter(r=>r.espelhoRealizado && !r.envioFinReal && r.mesKey && r.mesKey<=cur);
  const concluidasGeral = filtered.filter(r=>r.espelhoRealizado && r.envioFinReal && r.mesKey && r.mesKey<=cur);
  const totalBase = emAndamentoGeral.length + concluidasGeral.length;
  const pct = totalBase? Math.round(100*concluidasGeral.length/totalBase) : 0;
  document.getElementById('bar-conclusao').style.width = pct+'%';
  document.getElementById('bar-conclusao-label').textContent = pct+'%';
  document.getElementById('bar-conclusao-foot').textContent = `${concluidasGeral.length} concluídas de ${totalBase} em andamento (mês atual + atrasados).`;

  // pizza — aplica segmento sobre a base já filtrada por resp
  const base = applySegment(andamento);
  const counts = {};
  PHASES.forEach(p=>counts[p.key]=0);
  base.forEach(r=>{ const ph=currentPhaseOf(r); if(ph) counts[ph.key]++; });

  const colors = ['#2C5C82','#3E7EA8','#5A9AC0','#D9722B','#E89352','#C24A3B','#8A8F94'];
  const ctx = document.getElementById('chart-pizza').getContext('2d');
  if(pizzaChart) pizzaChart.destroy();
  pizzaChart = new Chart(ctx,{
    type:'doughnut',
    data:{ labels:PHASES.map(p=>p.label), datasets:[{ data:PHASES.map(p=>counts[p.key]), backgroundColor:colors, borderColor:'#fff', borderWidth:2 }] },
    options:{
      plugins:{ legend:{ position:'bottom', labels:{ font:{family:"'Inter',sans-serif", size:10.5}, boxWidth:10 } } },
      onClick:(evt, els)=>{
        if(els.length){
          const idx = els[0].index;
          const key = PHASES[idx].key;
          pizzaFilterPhase = (pizzaFilterPhase===key)? null : key;
          // filtra toda a aba
          renderLista(base);
          renderFornecedorSelect(base);
          // limpa régua se fornecedor selecionado sumiu do filtro
          const sel = document.getElementById('select-fornecedor');
          if(sel.value && !Array.from(sel.options).some(o=>o.value===sel.value)){
            sel.value='';
            document.getElementById('fornecedor-ruler').innerHTML='';
          }
        }
      }
    }
  });

  renderLista(base);
  renderFornecedorSelect(base);
}

function renderLista(baseAndamento){
  const tbody = document.querySelector('#tabela-medicoes tbody');
  tbody.innerHTML='';
  let rows = baseAndamento;
  let label = '';
  if(pizzaFilterPhase){
    rows = rows.filter(r=>{ const ph=currentPhaseOf(r); return ph && ph.key===pizzaFilterPhase; });
    label = '— filtrado por: ' + PHASES.find(p=>p.key===pizzaFilterPhase).label;
  }
  document.getElementById('lista-filtro-label').textContent = label;
  rows.slice(0,300).forEach(r=>{
    const ph = currentPhaseOf(r);
    const tr=document.createElement('tr');
    tr.innerHTML = `<td>${r.fornecedor||''}</td><td>${monthLabel(r.mesKey)}</td><td>${r.setor||''}</td><td>${r.contrato||''}</td><td>${ph? ph.label : 'Concluída'}</td><td>${r.statusMed||''}</td>`;
    tbody.appendChild(tr);
  });
  if(!rows.length){
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--ink-soft);padding:20px;">Nenhuma medição nesse filtro.</td></tr>';
  }
}

function renderFornecedorSelect(base){
  const sel = document.getElementById('select-fornecedor');
  const cur = thisMonthKey();
  let source = base || medicoesRows.filter(r=>r.espelhoRealizado && !r.envioFinReal && r.mesKey && r.mesKey<=cur);
  if(pizzaFilterPhase){
    source = source.filter(r=>{ const ph=currentPhaseOf(r); return ph && ph.key===pizzaFilterPhase; });
  }

  // conta quantas medições em andamento cada fornecedor tem
  const countPerFornecedor = {};
  source.forEach(r=>{
    countPerFornecedor[r.fornecedor] = (countPerFornecedor[r.fornecedor]||0)+1;
  });

  // gera entradas únicas: se >1 medição, adiciona o mês; senão, só o nome
  const entries = source.map(r=>{
    const label = countPerFornecedor[r.fornecedor] > 1
      ? `${r.fornecedor} (${monthLabel(r.mesKey)})`
      : r.fornecedor;
    return { label, fornecedor: r.fornecedor, mesKey: r.mesKey };
  });

  // dedup por label
  const seen = new Set();
  const unique = entries.filter(e=>{ if(seen.has(e.label)) return false; seen.add(e.label); return true; });
  unique.sort((a,b)=>a.label.localeCompare(b.label));

  const prev = sel.value;
  sel.innerHTML = '<option value="">Selecione um fornecedor…</option>'
    + unique.map(e=>`<option value="${e.fornecedor}||${e.mesKey}">${e.label}</option>`).join('');
  if(prev && Array.from(sel.options).some(o=>o.value===prev)) sel.value = prev;
}

