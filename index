let caucoesRows = [];
let caucoesFiltro = 'todos';
let encerramentoFiltro = 'todos';
let caucoesPizzaChart = null;
let caucoesLinhaChart = null;

/* ---------- helpers ---------- */
function fmtBRL(v){
  if(v===null||v===undefined||v==='') return '—';
  const n = parseFloat(v);
  if(isNaN(n)) return '—';
  return n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
}
function parseDate(v){
  if(!v) return null;
  const s = String(v).trim();
  if(!s || s==='None' || s==='N/A' || s==='#VALUE!' || s==='PENDENTE') return null;
  // número serial Excel
  if(/^\d+(\.\d+)?$/.test(s)){
    const n = parseFloat(s);
    if(n < 2000) return null; // data nula tipo 1901-12-20
    const d = new Date(Math.round((n - 25569)*86400*1000));
    return isNaN(d) ? null : d;
  }
  // string de data
  const d = new Date(s);
  if(isNaN(d)) return null;
  if(d.getFullYear() < 1950) return null; // data nula Excel
  return d;
}
function fmtDateBR(d){
  if(!d) return '—';
  return d.toLocaleDateString('pt-BR');
}

/* ---------- XLSX parsing: cauções ---------- */
function parseCaucoes(workbook){
  const sheetName = workbook.SheetNames.find(n=>norm(n).includes('lote1')) || workbook.SheetNames[0];
  const ws = workbook.Sheets[sheetName];
  const rows = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, cellDates:true, defval:null});

  // header na linha com COD. CONTRATO e SITUAÇÃO
  let hIdx = -1;
  for(let i=0;i<rows.length;i++){
    const cells = (rows[i]||[]).map(c=>norm(String(c||'')));
    if(cells.some(c=>c.includes('cod') && c.includes('contrato')) && cells.some(c=>c.includes('situa'))){
      hIdx=i; break;
    }
  }
  if(hIdx===-1) throw new Error('Cabeçalho não encontrado. Verifique se o arquivo é a planilha de Contratos Lote 1.');
  const header = rows[hIdx];

  function col(keywords){
    for(let i=0;i<header.length;i++){
      const c=norm(String(header[i]||''));
      if(keywords.every(k=>c.includes(k))) return i;
    }
    return -1;
  }

  const c = {
    cod:       col(['cod','contrato']),
    contratado:col(['contratado']),
    situacao:  col(['situa']),
    termino:   col(['termino']),
    valorTotal:col(['valor','total']),
    valorRetido:   col(['valor','retido']),
    valorDevolvido:col(['valor','devolvido']),
    saldoCaucao:   col(['saldo','caucao']),
    dtEncerramento:col(['data','encerramento']),
    dtRealizada:   col(['data','realizada','caucao']),
    dtProgramada:  col(['data','programada','caucao']),
    statusCaucao:  col(['status','caucao']),
  };

  const data = [];
  for(let i=hIdx+1;i<rows.length;i++){
    const r = rows[i];
    if(!r || !isFilled(r[c.cod])) continue;
    const codVal = String(r[c.cod]||'').trim();
    if(!/[A-Z0-9_]{3,}/i.test(codVal)) continue;

    // Data de caução: dt_programada, ou status_caucao se dt_programada for #VALUE!
    let dtProg = parseDate(r[c.dtProgramada]);
    const dtReal = parseDate(r[c.dtRealizada]);
    // fallback: status_caucao pode ter a data quando dt_programada é #VALUE!
    if(!dtProg && c.statusCaucao>-1){
      const sc = r[c.statusCaucao];
      if(sc instanceof Date) dtProg = sc;
      else dtProg = parseDate(sc);
    }

    const termino = parseDate(r[c.termino]);
    const dtEncerr = parseDate(r[c.dtEncerramento]);
    const situacao = String(r[c.situacao]||'').trim().toUpperCase();

    // só inclui na tabela de cauções se tem data de caução
    const temCaucao = !!(dtProg || dtReal);

    data.push({
      cod:           codVal,
      contratado:    String(r[c.contratado]||'').trim(),
      situacao,
      termino,
      dtEncerramento:dtEncerr,
      valorTotal:    parseFloat(r[c.valorTotal])||0,
      valorRetido:   parseFloat(r[c.valorRetido])||0,
      valorDevolvido:parseFloat(r[c.valorDevolvido])||0,
      saldoCaucao:   parseFloat(r[c.saldoCaucao])||0,
      dtRealizada:   dtReal,
      dtProgramada:  dtProg,
      temCaucao,
    });
  }
  return data;
}

/* ---------- render cauções ---------- */
function renderCaucoes(){
  const content = document.getElementById('caucoes-content');
  const empty   = document.getElementById('caucoes-empty');
  content.style.display = caucoesRows.length ? 'block':'none';
  empty.style.display   = caucoesRows.length ? 'none':'block';
  if(!caucoesRows.length) return;

  // BARRA DE AVANÇO
  const totalRetido    = caucoesRows.reduce((s,r)=>s+r.valorRetido,0);
  const totalDevolvido = caucoesRows.reduce((s,r)=>s+r.valorDevolvido,0);
  const pctBar = totalRetido>0 ? Math.min(100,Math.round(100*totalDevolvido/totalRetido)) : 0;
  document.getElementById('cau-bar-fill').style.width = pctBar+'%';
  document.getElementById('cau-bar-pct').textContent  = pctBar+'%';
  document.getElementById('cau-bar-label-real').textContent  = 'Realizado: '+fmtBRL(totalDevolvido);
  document.getElementById('cau-bar-label-total').textContent = 'Total Retido: '+fmtBRL(totalRetido);
  document.getElementById('cau-bar-foot').textContent = `Saldo pendente: ${fmtBRL(totalRetido-totalDevolvido)}`;

  // PIZZA: situações
  const sitCounts = {};
  caucoesRows.forEach(r=>{ sitCounts[r.situacao]=(sitCounts[r.situacao]||0)+1; });
  const sitLabels = Object.keys(sitCounts);
  const sitColors = ['#27AE60','#2F80ED','#F2994A','#C24A3B'];
  const ctxPizza = document.getElementById('chart-caucoes-pizza').getContext('2d');
